# Use the {shop}.myshopify.com address here, not your custom domain — even
# though a custom domain connected to Shopify also answers Storefront API
# requests today, it stops working the moment that domain's DNS points
# somewhere else (e.g. once it's pointed at this site's own host). The
# myshopify.com domain always reaches Shopify directly, regardless of where
# the custom domain currently points.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-private-storefront-access-token

# Shopify admin → Settings → Notifications → Webhooks. Create webhooks for
# products/create, products/update, products/delete and
# inventory_levels/update, all pointing at {site}/api/revalidate, then copy
# the shared secret Shopify shows at the bottom of that page.
# Without this, product edits take up to 5 minutes to appear instead of being
# reflected on the next page view.
SHOPIFY_WEBHOOK_SECRET=

# --- Customer accounts (sign in, order history) ---
#
# From Shopify admin: Settings > Customer accounts (turn accounts on), then
# Sales channels > Headless > your storefront > Customer Account API settings.
# In "Application setup", add this exact Callback URL:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/callback
# and this Logout URL:
#   {NEXT_PUBLIC_SITE_URL}
# Shopify does not accept http:// or localhost callback URLs, so this whole
# feature needs the site deployed (even to a Vercel preview URL) before it can
# be configured or tested.
#
# Copy the Client ID and the three endpoint URLs shown on that screen
# verbatim — don't guess at the URL shape, Shopify's own setup guide says to
# record them from there.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZE_URL=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URL=
# The Customer Account API's GraphQL endpoint. Shown on the same settings
# screen; typically https://{shop}.myshopify.com/customer/api/2026-07/graphql
# but may use a custom "customer accounts domain" instead — use whatever is
# actually shown there.
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=

# The site's own public URL, used to build the OAuth redirect URI above.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example
